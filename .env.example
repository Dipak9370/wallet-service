# Used by docker-compose (creates the DB) AND by the Go app / tests.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wallet
POSTGRES_PORT=5432

DATABASE_URL=postgres://postgres:postgres@localhost:5432/wallet?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wallet?sslmode=disable
HTTP_ADDR=:8080
